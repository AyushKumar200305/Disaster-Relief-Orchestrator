modules = ["nodejs-20", "python-3.12", "web"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Flood Response Dashboard"

[[workflows.workflow]]
name = "Flood Response Dashboard"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sh -c '.venv/bin/uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 & cd frontend && pnpm run dev -- --host 0.0.0.0'"
waitForPort = 5173

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["libxcrypt", "postgresql"]
